-- Tabla para preguntas del test
CREATE TABLE preguntas_test (
    id INT PRIMARY KEY AUTO_INCREMENT,
    pregunta TEXT NOT NULL,
    opcion_visual VARCHAR(255) NOT NULL,
    opcion_auditivo VARCHAR(255) NOT NULL,
    opcion_kinestesico VARCHAR(255) NOT NULL
);

-- Tabla para recursos de ciencias naturales
CREATE TABLE recursos_ciencias (
    id INT PRIMARY KEY AUTO_INCREMENT,
    titulo VARCHAR(255) NOT NULL,
    descripcion TEXT NOT NULL,
    tipo ENUM('visual', 'auditivo', 'kinestesico') NOT NULL,
    url VARCHAR(255) NOT NULL,
    imagen_url VARCHAR(255) NULL
);

