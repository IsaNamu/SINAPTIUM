-- Tabla permisos
CREATE TABLE permisos (
    id INT PRIMARY KEY AUTO_INCREMENT,
    nombre VARCHAR(100) NOT NULL UNIQUE,
    descripcion TEXT NULL
);

-- Tabla roles
CREATE TABLE roles (
    id INT PRIMARY KEY AUTO_INCREMENT,
    nombre VARCHAR(100) NOT NULL UNIQUE,
    descripcion TEXT NULL
);

-- Tabla intermedia roles_x_permiso (relación muchos a muchos)
CREATE TABLE roles_x_permiso (
    id INT PRIMARY KEY AUTO_INCREMENT,
    permiso_id INT NOT NULL,
    rol_id INT NOT NULL,
    FOREIGN KEY (permiso_id) REFERENCES permisos(id) ON DELETE CASCADE,
    FOREIGN KEY (rol_id) REFERENCES roles(id) ON DELETE CASCADE,
    UNIQUE KEY unique_permiso_rol (permiso_id, rol_id)
);

-- Tabla de métodos de aprendizaje
CREATE TABLE metodos_aprendizaje (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(50) NOT NULL UNIQUE,
    descripcion TEXT,
    fecha_creacion TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Tabla usuario (completa desde el inicio)
CREATE TABLE usuario (
    id INT PRIMARY KEY AUTO_INCREMENT,
    usuario VARCHAR(50) NOT NULL UNIQUE,
    correo VARCHAR(255) NOT NULL UNIQUE,
    passwd VARCHAR(255) NOT NULL,
    metodo_aprendizaje_id INT NULL,
    rol_id INT NOT NULL,
    estado ENUM('Activo', 'Inactivo', 'Bloqueado') DEFAULT 'Activo',
    fecha_creacion TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    fecha_modificacion TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (rol_id) REFERENCES roles(id) ON DELETE RESTRICT,
    FOREIGN KEY (metodo_aprendizaje_id) REFERENCES metodos_aprendizaje(id) ON DELETE SET NULL
);

-- 1. Tabla de categorías (para normalizar el campo categoría)
CREATE TABLE categorias (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(50) NOT NULL UNIQUE,
    descripcion TEXT,
    fecha_creacion TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- 2. Tabla de autores (para normalizar el campo autor)
CREATE TABLE autores (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL,
    apellido VARCHAR(100),
    biografia TEXT,
    fecha_creacion TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- 3. Tabla principal de biblioteca (simplificada)
CREATE TABLE biblioteca (
    id INT AUTO_INCREMENT PRIMARY KEY,
    titulo VARCHAR(255) NOT NULL,
    enlace VARCHAR(500) DEFAULT '',
    imagen VARCHAR(500) DEFAULT '',
    archivo_pdf VARCHAR(500) DEFAULT '',
    categoria_id INT,
    autor_id INT,
    fecha_creacion TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    fecha_actualizacion TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    FOREIGN KEY (categoria_id) REFERENCES categorias(id) ON DELETE SET NULL,
    FOREIGN KEY (autor_id) REFERENCES autores(id) ON DELETE SET NULL
);

-- Tabla de materias (áreas de estudio)
CREATE TABLE materias (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nombre VARCHAR(100) NOT NULL UNIQUE,
    descripcion TEXT,
    color_codigo VARCHAR(7) COMMENT 'Código HEX para color representativo',
    icono VARCHAR(50) COMMENT 'Nombre del ícono representativo',
    activo BOOLEAN DEFAULT TRUE,
    fecha_creacion TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Tabla intermedia para relacionar materias con métodos de aprendizaje
CREATE TABLE materia_metodo_aprendizaje (
    id INT AUTO_INCREMENT PRIMARY KEY,
    materia_id INT NOT NULL,
    metodo_aprendizaje_id INT NOT NULL,
    titulo VARCHAR(255) NOT NULL,
    contenido TEXT NOT NULL COMMENT 'Contenido adaptado al método de aprendizaje',
    recursos VARCHAR(500) COMMENT 'Enlaces o recursos específicos',
    imagen VARCHAR(500) DEFAULT 'https://placehold.co/600x400?text=Sin+Imagen' COMMENT 'Imagen representativa del método de aprendizaje',
    activo BOOLEAN DEFAULT TRUE,
    fecha_creacion TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (materia_id) REFERENCES materias(id) ON DELETE CASCADE,
    FOREIGN KEY (metodo_aprendizaje_id) REFERENCES metodos_aprendizaje(id) ON DELETE CASCADE
);

-- Índices adicionales para mejorar el rendimiento
CREATE INDEX idx_usuario_correo ON usuario(correo);
CREATE INDEX idx_roles_x_permiso_permiso ON roles_x_permiso(permiso_id);
CREATE INDEX idx_roles_x_permiso_rol ON roles_x_permiso(rol_id);
CREATE INDEX idx_usuario_rol ON usuario(rol_id);
CREATE INDEX idx_biblioteca_titulo ON biblioteca(titulo);
CREATE INDEX idx_biblioteca_categoria ON biblioteca(categoria_id);
CREATE INDEX idx_biblioteca_autor ON biblioteca(autor_id);
CREATE INDEX idx_autores_nombre ON autores(nombre, apellido);
CREATE INDEX idx_materias_activo ON materias(activo);
CREATE INDEX idx_materia_metodo_materia ON materia_metodo_aprendizaje(materia_id);
CREATE INDEX idx_materia_metodo_metodo ON materia_metodo_aprendizaje(metodo_aprendizaje_id);
CREATE INDEX idx_materia_metodo_activo ON materia_metodo_aprendizaje(activo);

